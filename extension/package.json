{
  "name": "vscode-ai-extension",
  "displayName": "AI Assistant with LiteLLM",
  "description": "VSCode AI Extension using LiteLLM Proxy with automatic fallback",
  "version": "0.1.0",
  "publisher": "edward4dt",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onView:ai-assistant.chatPanel",
    "onCommand:ai-assistant.askAI",
    "onCommand:ai-assistant.checkHealth"
],
  "main": "./out/extension.js",
  "files": [
    "out",
    "resources",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/edward4dt/qwen-llm-starter-kit.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/edward4dt/qwen-llm-starter-kit",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-assistant",
          "title": "AI Assistant",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-assistant": [
        {
          "type": "webview",
          "id": "ai-assistant.chatPanel",
          "name": "Chat",
          "icon": "$(comment-discussion)",
          "contextualTitle": "AI Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-assistant.askAI",
        "title": "Ask AI: 向 AI 提問",
        "category": "AI Assistant"
      },
      {
        "command": "ai-assistant.focusChatPanel",
        "title": "Focus Chat Panel",
        "category": "AI Assistant",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ai-assistant.checkHealth",
        "title": "Check LiteLLM Health",
        "category": "AI Assistant",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ai-assistant.checkHealth",
          "when": "view == ai-assistant.chatPanel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "typescript": "^5.0.0"
  }
}
